<?xml version="1.0" encoding="UTF-8" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tabSelectedTextColorLight" />
            <corners android:radius="@dimen/radius_100" />
            <stroke android:width="@dimen/size_1" android:color="@color/tabSelectedTextColorLight" />
            <size android:width="@dimen/size_40" android:height="@dimen/size_20" />
        </shape>
    </item>

    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_bg_color" />
            <corners android:radius="@dimen/radius_100" />
            <stroke android:width="@dimen/size_1" android:color="@color/chip_bg_color" />
            <size android:width="@dimen/size_40" android:height="@dimen/size_20" />
        </shape>
    </item>

</selector>