<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp"/>
            <solid android:color="@color/tabSelectedTextColor"/> <!-- Filled circle -->
            <padding
                android:left="@dimen/padding_10"
                android:right="@dimen/padding_10"/>
        </shape>
    </item>

    <!-- Unchecked state -->
    <item>
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp"/>
            <stroke android:width="2dp" android:color="#9E9E9E"/>
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

</selector>
