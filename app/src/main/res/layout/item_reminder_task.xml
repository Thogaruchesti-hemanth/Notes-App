<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/size_300"
    android:layout_height="@dimen/size_100"
    app:cardCornerRadius="@dimen/radius_50"
    app:cardElevation="@dimen/elevation_4"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/taskContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/padding_10">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_reminders"
            android:drawablePadding="@dimen/margin_8" />

        <View
            android:layout_width="@dimen/size_1"
            android:layout_height="@dimen/size_24"
            android:layout_marginHorizontal="@dimen/margin_10"
            android:background="@android:color/white"
            android:alpha="0.3" />

        <LinearLayout
            android:layout_width="@dimen/size_130"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_14"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2"
                android:textSize="@dimen/text_10"
                android:textColor="@color/white"
                android:alpha="0.8"
                android:background="@drawable/bg_transparent_white_12dp"
                android:paddingHorizontal="@dimen/padding_8"
                android:paddingVertical="@dimen/padding_2" />

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:layout_marginStart="@dimen/margin_8"
            android:contentDescription="@string/text_forward_arrow"
            android:src="@drawable/ic_chevron_right"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>