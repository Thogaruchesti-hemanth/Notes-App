<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".activity.SplashScreenActivity">

    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="@dimen/size_4xl"
        android:layout_height="@dimen/size_4xl"
        android:contentDescription="@string/text_splash_screen_logo"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_logo_light" />

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:fontFamily="sans-serif-medium"
        android:text="@string/text_notes_nest"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_4xl"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs2"
        android:fontFamily="sans-serif-light"
        android:text="@string/text_nest_your_ideas_let_them_take_flight"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_md" />

    <ProgressBar
        android:id="@+id/splash_progress"
        android:layout_width="@dimen/size_xl2"
        android:layout_height="@dimen/size_xl2"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary" />

</LinearLayout>
