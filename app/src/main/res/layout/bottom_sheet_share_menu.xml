<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/padding_20"
    android:paddingVertical="@dimen/padding_10">

    <View
        android:layout_width="@dimen/size_50"
        android:layout_height="@dimen/size_5"
        android:layout_gravity="center"
        android:layout_margin="@dimen/margin_10"
        android:background="@color/grey_900" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_20"
        android:text="@string/text_share_note"
        android:textSize="@dimen/text_20"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvShareText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_text"
        android:drawablePadding="@dimen/padding_20"
        android:paddingVertical="@dimen/padding_8"
        android:text="@string/text_share_as_text"
        android:textSize="@dimen/text_18" />

    <LinearLayout
        android:id="@+id/layoutShareImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_8">

        <ImageView
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:contentDescription="@string/text_image_icon"
            android:src="@drawable/ic_image" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_20"
            android:layout_weight="1"
            android:text="@string/text_share_as_image"
            android:textSize="@dimen/text_18" />

        <ImageView
            android:id="@+id/ivPremiumImage"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:src="@drawable/ic_pro"
            android:visibility="visible"
            android:contentDescription="@string/text_premium_badge"
            app:tint="@color/tabSelectedTextColorLight" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSharePDF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_8">

        <ImageView
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:contentDescription="@string/text_pdf_icon"
            android:src="@drawable/ic_pdf" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_20"
            android:layout_weight="1"
            android:text="@string/text_share_as_pdf"
            android:textSize="@dimen/text_18" />

        <ImageView
            android:id="@+id/ivPremiumPDF"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:src="@drawable/ic_pro"
            android:visibility="visible"
            android:contentDescription="@string/text_premium_badge"
            app:tint="@color/tabSelectedTextColorLight" />
    </LinearLayout>

</LinearLayout>