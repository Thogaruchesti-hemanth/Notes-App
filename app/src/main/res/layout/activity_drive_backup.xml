<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- App Bar -->
    <LinearLayout
        android:id="@+id/appbar_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_arrow_icon"
            android:layout_width="@dimen/size_32"
            android:layout_height="@dimen/size_32"
            android:contentDescription="@string/text_back_button"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_32"
            android:text="Drive Backup"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_22"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Initial Setup View (Visible when not signed in) -->
            <LinearLayout
                android:id="@+id/layoutSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/size_120"
                    android:layout_height="@dimen/size_120"
                    android:layout_marginBottom="@dimen/margin_20"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/google_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:text="Google Drive Backup"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_24"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_24"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Securely backup your notes and attachments to Google Drive. Your data will be encrypted and stored safely."
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_14" />

                <Button
                    android:id="@+id/btnAddAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_40"
                    android:layout_marginTop="@dimen/margin_16"
                    android:backgroundTint="@color/google_blue"
                    android:drawableStart="@drawable/ic_google"
                    android:drawablePadding="@dimen/padding_8"
                    android:padding="@dimen/padding_12"
                    android:text="Connect Google Account"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16"
                    android:gravity="center"
                    android:text="Your notes will be backed up automatically based on your settings"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/text_12" />
            </LinearLayout>

            <!-- Account Info View (Visible when signed in) -->
            <LinearLayout
                android:id="@+id/layoutAccountInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/size_80"
                        android:layout_height="@dimen/size_80"
                        android:src="@drawable/ic_profile"
                        android:tint="@color/tabSelectedTextColorLight" />

                    <TextView
                        android:id="@+id/txtEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Not signed in"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_4"
                        android:background="@drawable/btn_rounded_blue"
                        android:drawablePadding="@dimen/padding_12"
                        android:gravity="center_vertical"
                        android:padding="@dimen/padding_8"
                        android:text="@string/text_not_connected_to_drive"
                        android:textColor="@color/blue"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Settings Section -->
            <TextView
                android:id="@+id/textSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="@dimen/padding_12"
                android:text="SETTINGS"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Enable Automatic Backups -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Enable Automatic Backups" />

                        <Switch
                            android:id="@+id/switchAutoBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Frequency -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Backup Frequency" />

                        <Spinner
                            android:id="@+id/spinnerFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Attachments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Include Attachments" />

                        <Switch
                            android:id="@+id/switchAttachments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status Section -->
            <TextView
                android:id="@+id/textStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="@dimen/padding_12"
                android:text="STATUS"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_8">

                    <ImageView
                        android:id="@+id/imgStatusIcon"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:layout_margin="@dimen/margin_8"
                        android:background="@drawable/btn_rounded_green"
                        android:src="@drawable/ic_sync"
                        android:tint="@color/google_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lastBackupTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Last Backup"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtLastBackupTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Never backed up"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_8"
                        android:src="@drawable/ic_tick_done"
                        android:tint="@color/google_green"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Backup Now Button -->
            <Button
                android:id="@+id/btnBackupNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Backup Now"
                android:visibility="gone" />

            <!-- Disconnect Button -->
            <TextView
                android:id="@+id/btnDisconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center"
                android:text="Disconnect Google Account"
                android:textColor="@color/red"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>