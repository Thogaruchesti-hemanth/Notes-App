<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSecondary"
        android:titleTextColor="@color/tabSelectedTextColor"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="?attr/colorPrimary" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        tools:ignore="SpeakableTextPresentCheck">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Initial Setup View (Visible when not signed in) -->
            <LinearLayout
                android:id="@+id/layoutSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/size_120"
                    android:layout_height="@dimen/size_120"
                    android:layout_marginBottom="@dimen/margin_20"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@string/text_backup_account_profile"
                    app:tint="@color/tabSelectedTextColorLight" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:text="@string/text_google_drive_backup"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_24"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_24"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/text_securely_backup_your_notes_and_attachments_to_google_drive_your_data_will_be_encrypted_and_stored_safely"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_14" />

                <Button
                    android:id="@+id/btnAddAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_40"
                    android:layout_marginTop="@dimen/margin_16"
                    android:backgroundTint="?attr/colorPrimary"
                    android:drawableStart="@drawable/ic_google"
                    android:drawablePadding="@dimen/padding_8"
                    android:padding="@dimen/padding_12"
                    android:text="@string/text_connect_google_account"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16"
                    android:gravity="center"
                    android:text="@string/text_your_notes_will_be_backed_up_based_on_your_selected_mode"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/text_12" />
            </LinearLayout>

            <!-- Account Info View (Visible when signed in) -->
            <LinearLayout
                android:id="@+id/layoutAccountInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_30"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="@dimen/size_80"
                        android:layout_height="@dimen/size_80"
                        android:src="@drawable/ic_profile"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/text_user_name"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_18"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxWidth="300dp"
                        android:ellipsize="middle"
                        android:text="@string/text_not_signed_in"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_14" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_rounded_blue"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/text_not_connected_to_drive"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="@dimen/text_12" />
            </LinearLayout>

            <!-- Settings Section -->
            <TextView
                android:id="@+id/textSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="@dimen/padding_12"
                android:text="@string/text_backup_settings"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Backup Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/text_select_frequency"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                            <AutoCompleteTextView
                                android:id="@+id/dropdownFrequency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/text_backup_frequency"
                                android:inputType="none"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Enable Automatic Backups -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_enable_automatic_backups"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/selector_switch_thumb"
                            app:track="@drawable/selector_switch_track"
                            app:trackTint="@null"
                            app:thumbTint="@null"/>
                    </LinearLayout>

                    <!-- Attachments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/text_include_attachments"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAttachments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/selector_switch_thumb"
                            app:track="@drawable/selector_switch_track"
                            app:trackTint="@null"
                            app:thumbTint="@null"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Section -->
            <TextView
                android:id="@+id/textStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="@dimen/padding_12"
                android:text="@string/text_backup_status"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_8">

                    <ImageView
                        android:id="@+id/imgStatusIcon"
                        android:layout_width="@dimen/size_32"
                        android:layout_height="@dimen/size_32"
                        android:layout_margin="@dimen/margin_8"
                        android:contentDescription="@string/text_sync_icon"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/google_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lastBackupTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_last_backup"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtLastBackupTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_never_backed_up"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_8"
                        android:src="@drawable/ic_tick_done"
                        android:contentDescription="@string/text_backup_complete_icon"
                        app:tint="@color/google_green"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup Now Button -->
            <LinearLayout
                android:id="@+id/layoutBackupButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackupNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="40dp"
                    android:background="@drawable/btn_rounded"
                    android:text="@string/text_backup_now"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="@dimen/text_16" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRestoreNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="40dp"
                    android:background="@drawable/btn_rounded_blue"
                    android:text="@string/text_restore_from_drive"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="@dimen/text_16" />
            </LinearLayout>

            <!-- Disconnect Button -->
            <TextView
                android:id="@+id/btnDisconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:layout_marginHorizontal="40dp"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/text_disconnect_google_account"
                android:textColor="@color/red"
                android:textSize="@dimen/text_14"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>