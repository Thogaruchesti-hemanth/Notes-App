<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="250dp"
    android:background="?attr/colorSecondary"
    android:padding="@dimen/padding_20">

    <ImageView
        android:id="@+id/edit_header_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20"
        android:contentDescription="@string/text_edit_icon"
        android:src="@drawable/ic_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PROFILE IMAGE WITH PREMIUM INDICATOR -->
    <FrameLayout
        android:id="@+id/profile_container"
        android:layout_width="@dimen/size_80"
        android:layout_height="@dimen/size_80"
        android:layout_marginBottom="@dimen/margin_16"
        app:layout_constraintBottom_toTopOf="@id/get_pro_button"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Premium ring (hidden by default) -->
        <View
            android:id="@+id/premium_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_premium_ring"
            android:visibility="gone" />

        <!-- Profile Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/header_profile_image"
            android:layout_width="@dimen/size_72"
            android:layout_height="@dimen/size_72"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle" />

        <!-- Premium badge -->
        <ImageView
            android:id="@+id/premium_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:src="@drawable/ic_pro"
            app:tint="@color/tabSelectedTextColorLight"
            android:visibility="gone" />

    </FrameLayout>


    <LinearLayout
        android:id="@+id/header_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_20"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/profile_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/profile_container"
        app:layout_constraintTop_toTopOf="@id/profile_container">

        <TextView
            android:id="@+id/header_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/get_pro_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_yellow_gradient"
        android:drawableStart="@drawable/ic_pro"
        android:drawablePadding="@dimen/padding_20"
        android:gravity="start"
        android:paddingHorizontal="@dimen/padding_20"
        android:paddingVertical="@dimen/padding_12"
        android:text="@string/text_premium_access"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="@dimen/text_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
