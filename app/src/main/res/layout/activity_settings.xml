<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSecondary"
        android:layout_marginHorizontal="10dp"
        android:titleTextColor="@color/tabSelectedTextColor"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="?attr/colorPrimary" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/padding_20"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_appearance"
                android:textAllCaps="true"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layoutNote"
                        layout="@layout/item_settings_option" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200" />

                    <include
                        android:id="@+id/layoutTheme"
                        layout="@layout/item_settings_option" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_marginBottom="@dimen/margin_10"
                android:text="@string/text_caps_backup_sync"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="@dimen/elevation_2"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layoutLocalBackup"
                        layout="@layout/item_support_option"
                        android:tag="local_backup" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200" />

                    <include
                        android:id="@+id/layoutDiveBackup"
                        layout="@layout/item_support_option"
                        android:tag="drive_backup" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200" />

                    <include
                        android:id="@+id/layoutImportData"
                        layout="@layout/item_support_option"
                        android:tag="import_data" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_marginBottom="@dimen/margin_10"
                android:text="@string/text_account"
                android:textAllCaps="true"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layoutManageAccount"
                        layout="@layout/item_support_option"
                        android:tag="local_backup" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200" />

                    <include
                        android:id="@+id/layoutChangePassword"
                        layout="@layout/item_support_option"
                        android:tag="drive_backup" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_marginBottom="@dimen/margin_10"
                android:text="@string/text_about"
                android:textAllCaps="true"
                android:textColor="@color/tabSelectedTextColorLight"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_10"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/padding_10"
                        android:paddingVertical="@dimen/padding_20"
                        android:gravity="center_vertical"
                        android:text="@string/text_app_version"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_16"
                        app:drawableStartCompat="@drawable/ic_about_app"
                        app:drawableTint="?attr/colorPrimary"
                        android:drawablePadding="@dimen/margin_12" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
