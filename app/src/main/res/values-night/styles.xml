<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomTimePickerTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/grey</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorAccent">@color/tabSelectedTextColor</item>
        <item name="android:colorAccent">@color/grey</item>

        <item name="android:textColorPrimary">@color/black</item>

        <item name="android:spinnerDropDownItemStyle">@style/TpSpinnerItemsNight</item>
    </style>

    <style name="TpSpinnerItemsNight" parent="@android:style/Widget.TextView.SpinnerItem">
        <item name="android:textColor">@color/black</item>
        <item name="dropDownBackgroundTint">@color/white</item>
    </style>


    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/grey</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorAccent">@color/tabSelectedTextColor</item>
        <item name="android:colorAccent">@color/grey</item>

        <item name="android:textColorPrimary">@color/black</item>
    </style>

</resources>